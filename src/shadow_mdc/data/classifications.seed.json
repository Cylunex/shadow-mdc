    },
    {
      "id": "types",
      "name": "作品类型",
      "description": "电影、剧集、动画、纪录片等作品大类。"
    },
    {
      "id": "genres",
      "name": "题材",
      "description": "剧情、喜剧、悬疑等内容题材。支持多选。"
    },
    {
      "id": "forms",
      "name": "表现形式",
