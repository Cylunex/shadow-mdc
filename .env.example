SHADOW_MDC_DATA_DIR=data
SHADOW_MDC_DATABASE_URL=sqlite:///data/shadow-mdc.db
SHADOW_MDC_JAVDB_BASE_URL=https://javdb.com
SHADOW_MDC_JAVBUS_BASE_URL=https://www.javbus.com
SHADOW_MDC_JAV321_BASE_URL=https://www.jav321.com
SHADOW_MDC_R18DEV_BASE_URL=https://r18.dev
SHADOW_MDC_FANZA_BASE_URL=https://www.dmm.co.jp
SHADOW_MDC_JAVLIBRARY_BASE_URL=https://www.javlibrary.com
SHADOW_MDC_MGSTAGE_BASE_URL=https://www.mgstage.com
SHADOW_MDC_FC2CLUB_BASE_URL=https://fc2club.top
SHADOW_MDC_FC2HUB_BASE_URL=https://javten.com
SHADOW_MDC_FC2CONTENTS_BASE_URL=https://adult.contents.fc2.com
SHADOW_MDC_PAIPANCON_BASE_URL=https://paipancon.com
SHADOW_MDC_AIRAV_BASE_URL=https://cn.airav.wiki
SHADOW_MDC_AVSOX_BASE_URL=https://avsox.click
SHADOW_MDC_FREEJAVBT_BASE_URL=https://freejavbt.com
SHADOW_MDC_THEPORNDB_GRAPHQL_URL=https://theporndb.net/graphql
# SHADOW_MDC_THEPORNDB_TOKEN=
SHADOW_MDC_REQUEST_TIMEOUT_SECONDS=20
SHADOW_MDC_REQUEST_RETRIES=1
SHADOW_MDC_IDENTIFY_CONCURRENCY=4
SHADOW_MDC_PROVIDER_CONCURRENCY=16
SHADOW_MDC_TRANSLATION_CONCURRENCY=4
# SHADOW_MDC_PROXY_URL=http://127.0.0.1:7890
# NAS production (current-year javranking refresh only):
# SHADOW_MDC_PROXY_URL=http://192.168.0.110:7893

# Weekly r18.dev dump refresh (NAS cron → scripts/nas/r18_dump_weekly.sh).
# Default off: stabilize a manual --force run before enabling cron.
# Crontab: CRON_TZ=Asia/Shanghai / 1 10 * * 3 (Wed 10:01).
# SHADOW_MDC_R18_DUMP_REFRESH_ENABLED=true
# SHADOW_MDC_R18_DUMP_REFRESH_CRON=1 10 * * 3
# SHADOW_MDC_R18_DUMP_REFRESH_TIMEZONE=Asia/Shanghai
# SHADOW_MDC_R18_DUMP_REFRESH_SERVICE=shadow-mdc
# SHADOW_MDC_R18_DUMP_REFRESH_HEALTH_URL=http://127.0.0.1:8700/api/health
SHADOW_MDC_TRANSLATION_ENABLED=true
SHADOW_MDC_TRANSLATION_ENDPOINT=https://translate.google.com/translate_a/single
SHADOW_MDC_TRANSLATION_TARGET_LANGUAGE=zh-CN
SHADOW_MDC_ARTWORK_MAX_BYTES=26214400
SHADOW_MDC_TRANSLATION_BACKEND=google
# SHADOW_MDC_TRANSLATION_DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# SHADOW_MDC_TRANSLATION_DEEPL_API_KEY=
# SHADOW_MDC_TRANSLATION_DEEPLX_ENDPOINT=http://127.0.0.1:1188/translate
# SHADOW_MDC_TRANSLATION_CUSTOM_ENDPOINT=
SHADOW_MDC_TRANSLATION_PLOT=true
# SHADOW_MDC_AUTO_SEED_NON_JAV_WORKS=true

# API response cache (Redis). Empty disables Redis and uses in-process TTL dict.
# Local: redis://127.0.0.1:6379/0  |  NAS: redis://192.168.0.21:6379/0
SHADOW_MDC_REDIS_URL=redis://127.0.0.1:6379/0

# 115 Open Platform (temporary community client_id; prefer your own app)
SHADOW_MDC_PAN_CLIENT_ID=100197303
# SHADOW_MDC_PAN_CLIENT_SECRET=

# GFriends actress portraits (Filetree index + CDN)
SHADOW_MDC_GFRIENDS_FILETREE_URL=https://cdn.jsdelivr.net/gh/gfriends/gfriends@master/Filetree.json
SHADOW_MDC_GFRIENDS_CDN_BASE_URL=https://cdn.jsdelivr.net/gh/gfriends/gfriends@master
SHADOW_MDC_GFRIENDS_CACHE_TTL_HOURS=168

# OpenList auto re-login (NAS-only; prefer data/pan/openlist-credentials.json).
# When the stored JWT expires, username/password here (or in the credentials file)
# let the client POST /api/auth/login once and retry.
# SHADOW_MDC_OPENLIST_USERNAME=
# SHADOW_MDC_OPENLIST_PASSWORD=

# Forced rescrape budget per provider per day (429 when exceeded)
SHADOW_MDC_RESCRAPE_DAILY_QUOTA=300

# Online playback sites file (LOCAL/NAS only — gitignored). Schema: docs/dev/playback-sites.example.json
# Default when unset: {SHADOW_MDC_DATA_DIR}/playback-sites.local.json
# SHADOW_MDC_PLAYBACK_SITES_PATH=/data/project/shadow-mdc/shared/data/playback-sites.local.json

